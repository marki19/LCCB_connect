# Dependencies
node_modules/
*/node_modules/

# Logs & debug dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (NEVER PUSH)
.env
.env.*
*.env
*/.env
*/.env.*

# ...but the template holds no secrets and must be tracked (documents required vars).
!.env.example
!*/.env.example

# Expo & Metro
.expo/
*/.expo/
dist/
*/dist/
web-build/
*.tsbuildinfo

# OS, editor swap & merge residue
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# Supabase CLI local state (never commit)
supabase/.temp/
frontend/supabase/.temp/

# Test artifacts & coverage
.vitest/
*/.vitest/
coverage/
*/coverage/
.nyc_output/

# Local uploaded files (keep directory structure, ignore binary files)
backend/uploads/*
!backend/uploads/**/.gitkeep

# AI agent & local tool workspace state
.desloppify/
*/.desloppify/
.superpowers/
.kilo/
.thinkrail/
.cursor/

# Mobile native prebuild & signing keys
*.keystore
*.jks

# Temporary files & session tokens
*.tmp.*
*/*.tmp.*
*/*/*.tmp.*
*.tmp
*/*.tmp
session.json
*/session.json

