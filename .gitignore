!.env.example
!*/.env.example

# Expo & Metro
.expo/
*/.expo/
dist/
*/dist/
web-build/
*.tsbuildinfo

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Supabase CLI local state (never commit)
supabase/.temp/
frontend/supabase/.temp/

# Test artifacts
.vitest/
*/.vitest/

# Local uploaded files (keep directory structure, ignore binary files)
backend/uploads/*
!backend/uploads/**/.gitkeep

# desloppify local state
.desloppify/
