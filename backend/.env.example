# LCCB Connect — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env

PORT=3000

# Comma-separated list of allowed browser origins (CORS). Native iOS/Android
# requests send no Origin and are always allowed. Defaults to common Expo dev
# origins when unset. Set your real web origin(s) in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Postgres connection (Supabase).
# DATABASE_URL: shared transaction-mode pooler (used by the running API)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL: session-mode pooler (use this for migrations only)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase API (server-side). These are safe to keep on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only admin key. Used ONLY by trusted server code. NEVER ship this to the
# mobile app and NEVER prefix it with EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server secret for signup code hashes (HMAC-SHA256 of `email:code`). At least
# 16 characters. Required in production; rotating it invalidates in-flight codes.
OTP_PEPPER=change-me-to-a-long-random-string

# Server secret for MFA challenge tokens (HMAC-SHA256). At least 32 characters.
# REQUIRED — the server refuses to boot without it. Rotating it invalidates any
# in-flight MFA challenge (users simply sign in again).
MFA_CHALLENGE_SECRET=change-me-to-a-long-random-string

# Number of reverse-proxy hops to trust when reading the client IP.
# Unset = trust nothing (direct connection). Set to 1 behind a single
# nginx/Cloudflare/load-balancer hop so rate limits key on the real client.
# TRUST_PROXY=1

# ---- Postgres pool (db.js) --------------------------------------------------
# Bounded pool. Keep `max` under your Supabase connection ceiling.
# PG_POOL_MAX=20
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=5000

# Local-only password for scripts/seed-test-users.js. Never commit a real value.
# TEST_USER_PASSWORD=

# ---- Rate limits (per authenticated user) -----------------------------------
# Per-sender / per-action budgets. Leave unset for the defaults shown.
# RATE_LIMIT_SEND_MAX=50            # messages per minute (no daily ceiling)
# RATE_LIMIT_FRIEND_MAX=20          # friend requests per minute
# RATE_LIMIT_REPORT_MAX=20          # reports per hour (posts and messages)
# RATE_LIMIT_POST_MAX=10            # posts per minute
# RATE_LIMIT_POST_DAILY_MAX=50      # posts per 24 h
# RATE_LIMIT_REPOST_MAX=20          # reposts per minute
# RATE_LIMIT_REPOST_DAILY_MAX=100   # reposts per 24 h
# RATE_LIMIT_COMMENT_MAX=30         # comments per minute
# RATE_LIMIT_COMMENT_DAILY_MAX=200  # comments per 24 h
# RATE_LIMIT_THESIS_MAX=5           # thesis uploads per hour
# RATE_LIMIT_PREVIEW_MAX=10         # link previews per minute
# RATE_LIMIT_LIKE_MAX=60            # like toggles per minute
# RATE_LIMIT_MFA_CHALLENGE_MAX=5    # TOTP attempts per challenge / 15 min

# Pre-accept cap (§6 "one-line switch"). 0 / unset = unlimited (the locked
# decision). Set to 1 or 3 if pre-accept spam appears.
# MESSAGE_REQUEST_MAX=0

# ---- OS push (Expo Push Service, Messaging_plan.md §10) ---------------------
# Push is best-effort and needs an EAS dev build with FCM/APNs credentials.
# Set PUSH_ENABLED=false to disable outbound push entirely (e.g. staging).
# PUSH_ENABLED=true

# ---- Retention sweep (scripts/prune.js) -------------------------------------
# DEVICE_TOKEN_TTL_DAYS=90
# MESSAGE_REPORT_TTL_DAYS=180
# NOTIFICATION_TTL_DAYS=90
