# LCCB Connect — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env

PORT=3000

# Comma-separated list of allowed browser origins (CORS). Native iOS/Android
# requests send no Origin and are always allowed. Defaults to common Expo dev
# origins when unset. Set your real web origin(s) in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Postgres connection (Supabase).
# DATABASE_URL: shared transaction-mode pooler (used by the running API)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL: session-mode pooler (use this for migrations only)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase API (server-side). These are safe to keep on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only admin key. Used ONLY by trusted server code. NEVER ship this to the
# mobile app and NEVER prefix it with EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local-only password for scripts/seed-test-users.js. Never commit a real value.
# TEST_USER_PASSWORD=

# ---- Messaging rate limits (Messaging_plan.md §6, §13) ----------------------
# Per-sender budgets. Leave unset for the defaults shown.
# RATE_LIMIT_SEND_MAX=20          # sends per minute
# RATE_LIMIT_SEND_DAILY_MAX=200   # sends per 24 h
# RATE_LIMIT_FRIEND_MAX=20        # friend requests per minute
# RATE_LIMIT_REPORT_MAX=10        # message reports per minute

# Pre-accept cap (§6 "one-line switch"). 0 / unset = unlimited (the locked
# decision). Set to 1 or 3 if pre-accept spam appears.
# MESSAGE_REQUEST_MAX=0

# ---- OS push (Expo Push Service, Messaging_plan.md §10) ---------------------
# Push is best-effort and needs an EAS dev build with FCM/APNs credentials.
# Set PUSH_ENABLED=false to disable outbound push entirely (e.g. staging).
# PUSH_ENABLED=true

# ---- Retention sweep (scripts/prune.js) -------------------------------------
# DEVICE_TOKEN_TTL_DAYS=90
# MESSAGE_REPORT_TTL_DAYS=180
# NOTIFICATION_TTL_DAYS=90
