{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|favicon\\.ico|manifest\\.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
